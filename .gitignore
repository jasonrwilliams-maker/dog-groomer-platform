# Real client documents. Everything in here is gitignored wholesale — the
# previous rules matched by file extension, which meant a .heic (an allowed
# mime_type in the schema) or anything one directory deeper was NOT ignored.
# Directory-level is the only version of this that stays true as the corpus grows.
private/

.env

__pycache__/
.venv/
*.pyc
.DS_Store

# Model runs on private documents: raw responses contain PII, so the whole
# directory stays out of version control, same reasoning as private/.
extraction/runs/

# The web app: dependencies and build output live in its container.
web/node_modules/
web/.next/
web/next-env.d.ts
web/tsconfig.tsbuildinfo

# The browser demo's build: generated from sql/ and the PGlite package
# (web/scripts/demo-sql.mjs, demo-files.mjs), and its static output.
web/public/demo/
web/public/pglite/
web/out/
