# Copy to .env (gitignored). The local test database is configured directly in
# docker-compose.yml (postgres/postgres/grooming_test) so the README's psql
# commands work with no setup step; the harness service gets DATABASE_URL from
# there too.
#
# The two values below are for the extraction harness, which is the first part
# of this project that talks to anything outside the container.

# Your Anthropic API key. Never commit this file.
ANTHROPIC_API_KEY=

# The vision model the harness sends documents to. Whatever answers is recorded
# in extraction.model_version from the API response, so a run is always
# attributable to the exact model that produced it. Check the current model
# list at https://docs.claude.com/en/docs/about-claude/models before choosing.
EXTRACTION_MODEL=claude-sonnet-5
